{
    "name": "fixit-ai-agent-backend",
    "version": "1.0.0",
    "description": "FixIt AI Agent - return inspection backend",
    "main": "dist/server.js",
    "scripts": {
        "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
        "build": "tsc -p tsconfig.bundle.json && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
        "start": "node dist/server.js",
        "typecheck": "tsc -p tsconfig.bundle.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "seed": "tsx scripts/seed.ts",
        "db:local": "tsx scripts/localMongo.ts",
        "retention": "tsx scripts/retention.ts",
        "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\""
    },
    "license": "UNLICENSED",
    "type": "module",
    "dependencies": {
        "@anthropic-ai/sdk": "^0.135.0",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^18.0.8",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "ffmpeg-static": "^5.3.0",
        "ffprobe-static": "^3.1.0",
        "helmet": "^8.3.0",
        "http-status-codes": "^2.3.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.11.2",
        "morgan": "^1.12.1",
        "multer": "^2.4.0",
        "pdfkit": "^0.20.2",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/ffprobe-static": "^2.0.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.3.0",
        "@types/node": "^26.6.5",
        "@types/pdfkit": "^0.17.6",
        "@types/supertest": "^7.2.1",
        "@types/swagger-ui-express": "^4.1.8",
        "esbuild": "^0.28.2",
        "mongodb-memory-server": "^11.3.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.10",
        "supertest": "^7.3.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=20"
    },
    "private": true
}
