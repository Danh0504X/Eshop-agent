# ---------------------------------------------------------------------------
# FixIt AI Agent - backend configuration. Copy to .env and adjust.
# Never commit real secrets. All values below are placeholders.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# --- Database -------------------------------------------------------------
# Local MongoDB, Docker (docker run -p 27017:27017 mongo:7), or `npm run db:local`
MONGODB_URI=mongodb://127.0.0.1:27017/fixit

# --- Auth -----------------------------------------------------------------
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=8h

# --- AI -------------------------------------------------------------------
# DEMO_MODE=true uses predefined, clearly labelled demo results (NOT real AI analysis).
DEMO_MODE=true
# anthropic | demo
AI_PROVIDER=anthropic
# Anthropic API key (required when DEMO_MODE=false and AI_PROVIDER=anthropic). ANTHROPIC_API_KEY also works.
AI_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=high
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=2
# Let the API re-run a request on a fallback model if the primary model declines it
AI_REFUSAL_FALLBACK=true

# --- Agent ----------------------------------------------------------------
# llm = Claude plans tool calls; deterministic = fixed workflow (always used in demo mode)
AGENT_PLANNER=llm
AGENT_MAX_ITERATIONS=20
AGENT_TIMEOUT_MS=900000
AGENT_TOOL_TIMEOUT_MS=300000
AGENT_MAX_TOOL_RETRIES=2
MAX_FRAMES_PER_ANALYSIS=8

# --- Uploads & video processing --------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=200
MAX_VIDEO_DURATION_SEC=600
MIN_VIDEO_DURATION_SEC=2
FRAMES_PER_VIDEO=8
# Optional explicit binaries. Defaults: ffmpeg/ffprobe on PATH, else the bundled ffmpeg-static/ffprobe-static.
FFMPEG_PATH=
FFPROBE_PATH=
FFMPEG_TIMEOUT_MS=120000

# --- Evidence policy --------------------------------------------------------
# Model confidence below this triggers human review. It is not a calibrated probability.
CONFIDENCE_THRESHOLD=0.70
# Orders with declared value >= this always get a human review task
HIGH_VALUE_THRESHOLD=500
REQUIRE_VISIBLE_ORDER_ID=true
# Frame quality heuristics (0-255 mean luma; Laplacian variance)
MIN_FRAME_BRIGHTNESS=40
MIN_FRAME_SHARPNESS=15
MAX_BAD_FRAME_RATIO=0.5
MAX_TIMESTAMP_GAP_SEC=2

# --- Operations ---------------------------------------------------------------
RATE_LIMIT_INSPECTIONS_PER_15MIN=20
# Inspections processed in parallel by the in-process job queue
INSPECTION_CONCURRENCY=2
# Evidence and frames of resolved/rejected claims older than this are purged by `npm run retention`
RETENTION_DAYS=180
# >0 runs the retention sweep inside the server every N hours
RETENTION_SWEEP_HOURS=0
LOG_LEVEL=info

# --- Seed (development only) --------------------------------------------------
# Password for the seeded demo users. The seed script refuses to run when NODE_ENV=production.
SEED_USER_PASSWORD=dev-password-change-me
